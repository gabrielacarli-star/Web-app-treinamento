# Currency shown on the paywall (display only).
NEXT_PUBLIC_CURRENCY=USD

# External checkout links, one per plan (Hotmart / Kiwify).
# Any plan left unset falls back to /<locale>/success so the funnel stays walkable.
NEXT_PUBLIC_CHECKOUT_P7=
NEXT_PUBLIC_CHECKOUT_P4=
NEXT_PUBLIC_CHECKOUT_P12=

# Optional: receives { email, optIn, locale, variant, answers } on e-mail capture.
NEXT_PUBLIC_LEAD_WEBHOOK=

# Supabase — powers the member-area login and stores purchases.
# The member area is only gated once NEXT_PUBLIC_SUPABASE_URL is set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; used exclusively by the webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart webhook. HOTMART_HOTTOK is the token shown next to the postback URL
# in the Hotmart product settings; requests that do not match it are rejected.
HOTMART_HOTTOK=
# Map Hotmart offer codes to the plan ids used in src/lib/config.ts.
HOTMART_OFFER_P7=
HOTMART_OFFER_P4=
HOTMART_OFFER_P12=
