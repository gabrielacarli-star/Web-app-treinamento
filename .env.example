# Currency shown on the paywall (display only).
NEXT_PUBLIC_CURRENCY=USD

# External checkout links, one per plan (Hotmart / Kiwify).
# Any plan left unset falls back to /<locale>/success so the funnel stays walkable.
NEXT_PUBLIC_CHECKOUT_P7=
NEXT_PUBLIC_CHECKOUT_P4=
NEXT_PUBLIC_CHECKOUT_P12=

# Optional: receives { email, optIn, locale, variant, answers } on e-mail capture.
NEXT_PUBLIC_LEAD_WEBHOOK=
